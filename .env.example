# Buildathon demo environment. Copy to buildathon/.env and fill in.
# NEVER commit buildathon/.env to git.

# Razorpay TEST-MODE keys only (dashboard -> Test Mode -> API Keys).
# merchant/razorpay_client.py hard-refuses any key without the
# "rzp_test_" prefix -- this demo fires synthetic Sybil-ring purchase
# attempts and must never run against a live credential.
RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Price per credit in the mock "GPU inference credits" merchant demo.
PRICE_PER_CREDIT_INR=50

# Only needed for the autonomous AI buyer agent demo
# (python -m buildathon.demo.agent_demo -- see buildathon/agent/ and
# NOTES.md #18). The agent uses OpenAI gpt-4o-mini for its purchasing
# decisions only; it never scores anything and cannot bypass /buy-credits,
# so a leaked key here cannot move money past the merchant's caps. Nothing
# else in this folder -- demo_runner.py, the merchant, the tests -- needs
# this set.
OPENAI_API_KEY=

# Track 1's bar: "every money action explainable, bounded and gated." These
# two caps are enforced independent of what TRACE scores an agent -- a
# momentarily-high-trust agent still can't move unlimited money in one shot
# or in a rolling window. See buildathon/merchant/app.py.
MAX_CREDITS_PER_PURCHASE=20
MAX_ROLLING_AMOUNT_INR_PER_AGENT=2000
VELOCITY_WINDOW_SECONDS=300

# Optional: only needed to receive real Razorpay payment-capture webhooks
# (buildathon/merchant/webhooks.py). Separate from the root repo's
# RAZORPAY_WEBHOOK_SECRET (a different endpoint, different purpose) --
# generate this in the Razorpay dashboard when creating the webhook, under
# Test Mode. Requires a publicly reachable URL (e.g. ngrok) pointed at
# /webhooks/razorpay; not needed for the standard demo_runner.py run.
BUILDATHON_RAZORPAY_WEBHOOK_SECRET=

# Optional, comma-separated: who may call POST /buy-credits and GET
# /agents/{agent_id}/trust-check at all -- a caller-level gate, separate
# from and in addition to TRACE's own per-agent trust decision. Left unset,
# both endpoints stay open (correct for local dev and the pytest suite, but
# NOT what a live pitch recording or any real deployment should run with --
# set this before either). This proves who may call the merchant API; it
# does NOT prove a caller's claimed agent_id is genuinely theirs -- that
# would need per-agent cryptographic identity, a separate, larger piece of
# work this config flag does not attempt. If set, the frontend's Try It
# Live page needs the matching value in NEXT_PUBLIC_MERCHANT_API_KEY
# (frontend/app/try-it/TryItForm.tsx) -- note that a NEXT_PUBLIC_ value ships
# in client-side JS, so for a public demo page this is an access-log/intent
# signal, not a secret; treat it accordingly.
BUILDATHON_MERCHANT_API_KEYS=

# Optional, further narrows a configured key to specific agent_id(s):
# "key1=agent_a,agent_b;key2=agent_c". A key with no entry here stays
# unscoped (may act as any agent_id) -- so this is opt-in per key, not a
# global switch. This still does NOT prove the caller genuinely *is* the
# agent_id it claims (that needs per-agent cryptographic identity, still
# out of scope) -- it proves the caller holds a credential that was, out of
# band, configured to be allowed to claim that agent_id. Meaningfully
# narrows what a leaked/shared key could do; does not eliminate the
# underlying identity-binding gap. See merchant/app.py's
# _require_agent_scope and NOTES.md #13.
BUILDATHON_MERCHANT_API_KEY_AGENT_SCOPES=
